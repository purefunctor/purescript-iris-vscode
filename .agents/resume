#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
iris_executable="$repository_root/../repos/purescript-iris/target/debug/iris"

if [[ ! -x "$iris_executable" ]]; then
  echo "The linked Iris executable is missing; run .agents/setup to rebuild it." >&2
fi

echo "Orb resume checks complete."
